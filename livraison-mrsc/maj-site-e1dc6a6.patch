+                "registre": [f"{i} — {REGISTRE_LEGAL[i].titre}" for i in refs["registre"] if i in REGISTRE_LEGAL],
+                "non_resolu": [r for r in refs["articles"] if r not in ARTICLES] + [
+                    i for i in refs["registre"] if i not in REGISTRE_LEGAL
