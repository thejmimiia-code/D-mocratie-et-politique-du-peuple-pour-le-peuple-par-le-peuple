+      + `${echapperTexte(annee.note_hors_budget || '')} `
+      + `Conversion : ${(DIVISEUR_MENAGES && DIVISEUR_MENAGES.libelle) || 'ordre de grandeur'} `
+      + `(<b>${echapperTexte(statutDiviseur())}</b>).`;
