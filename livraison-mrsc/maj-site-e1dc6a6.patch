+    const solde = annee.solde_mde;
+    net.className = 'net ' + (Math.abs(solde) < 0.05 ? 'neutre' : (solde > 0 ? 'gain' : 'cout'));
+    net.textContent = `solde des classes : ${fmtSigne(solde, 1)} Md€/an`;
+  }
+  if (verdict){
+    const solde = annee.solde_mde;
+    verdict.textContent = Math.abs(solde) < 0.05
