+        "libelle": STATUTS[v.statut],
+        "verifie_le": v.verifie_le,
+        "source_url": v.source_url,
+        "note": v.note,
+        "page": f"{PAGE_VERIFICATION}#{cle}",
+        "formulaire": FORMULAIRE_CONTRIBUTION,
+    }
