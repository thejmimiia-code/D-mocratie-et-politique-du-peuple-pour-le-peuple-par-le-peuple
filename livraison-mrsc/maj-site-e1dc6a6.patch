+      : (solde > 0
+        ? `année ${annee.annee} : le plan dégage ${fmt(solde, 1)} Md€/an de marge`
+        : `année ${annee.annee} : le plan consomme ${fmt(Math.abs(solde), 1)} Md€/an de marge`);
